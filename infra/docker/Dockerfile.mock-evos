FROM node:20-alpine AS base
WORKDIR /app
RUN npm install -g pnpm turbo

COPY package.json pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY integrations/mock-evos ./integrations/mock-evos

RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @zayuno/contracts run build
RUN pnpm --filter @zayuno/mock-evos run build

EXPOSE 4001
CMD ["node", "integrations/mock-evos/dist/index.js"]
