FROM node:20-alpine
WORKDIR /app
RUN npm install -g pnpm
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY integrations/telegram-recruitment/package.json ./integrations/telegram-recruitment/package.json
RUN pnpm install --filter @zayuno/telegram-recruitment... --frozen-lockfile
COPY packages/contracts ./packages/contracts
COPY integrations/telegram-recruitment ./integrations/telegram-recruitment
RUN pnpm --filter @zayuno/contracts run build
RUN pnpm --filter @zayuno/telegram-recruitment run build
EXPOSE 4007
CMD ["node", "integrations/telegram-recruitment/dist/index.js"]
