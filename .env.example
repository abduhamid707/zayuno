# Environment
NODE_ENV=development
PORT=3000
API_PORT=4000
MCP_PORT=4002
MOCK_EVOS_PORT=4001
ADMIN_PORT=3000
PROVIDER_PORT=3001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zayuno?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# NATS JetStream
NATS_URL="nats://localhost:4222"

# Security & Encryption (AES-256-GCM 32-byte hex key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super-secret-jwt-key-for-zayuno-auth-change-in-production
# Developer Simulator Session Secret (HMAC-SHA256). Required in production.
SIMULATOR_SESSION_SECRET=
# Local-only convenience switch. Never enable this in production.
ALLOW_INSECURE_DEV_AUTH=false
# Comma-separated browser origins. Required in production.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
# Keep API documentation private in production unless explicitly enabled.
ENABLE_SWAGGER=false

# Webhook Secrets
ZAYUNO_WEBHOOK_SECRET=zayuno_webhook_secret_evos_test_key_123

# Sandbox Shared Secrets (Production / Staging Server-Side Credentials)
COFFEE_TIME_SHARED_SECRET=
MOCK_EVOS_SHARED_SECRET=
POYEZ_SANDBOX_SHARED_SECRET=

# Public URLs
API_BASE_URL="http://localhost:4000"
MOCK_EVOS_BASE_URL="http://localhost:4001"
MOCK_EVOS_CHECKOUT_BASE_URL="http://localhost:4001"

# Provider Health Monitoring
PROVIDER_HEALTH_INTERVAL_MS=60000
PROVIDER_HEALTH_TIMEOUT_MS=5000
PROVIDER_HEALTH_FAILURE_THRESHOLD=3
PROVIDER_HEALTH_RECOVERY_THRESHOLD=2
PROVIDER_HEALTH_MAX_CONCURRENCY=10
DISABLE_HEALTH_MONITOR=false


