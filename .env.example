# Environment
NODE_ENV=development
PORT=3000
API_PORT=4000
MCP_PORT=4002
MOCK_EVOS_PORT=4001
ADMIN_PORT=3000
PROVIDER_PORT=3001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zayuno?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# NATS JetStream
NATS_URL="nats://localhost:4222"

# Security & Encryption (AES-256-GCM 32-byte hex key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super-secret-jwt-key-for-zayuno-auth-change-in-production
# Local-only convenience switch. Never enable this in production.
ALLOW_INSECURE_DEV_AUTH=false
# Comma-separated browser origins. Required in production.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
# Keep API documentation private in production unless explicitly enabled.
ENABLE_SWAGGER=false

# Webhook Secrets
ZAYUNO_WEBHOOK_SECRET=zayuno_webhook_secret_evos_test_key_123

# Public URLs
API_BASE_URL="http://localhost:4000"
MOCK_EVOS_BASE_URL="http://localhost:4001"
MOCK_EVOS_CHECKOUT_BASE_URL="http://localhost:4001"
MOCK_EVOS_SHARED_SECRET="replace-with-a-random-shared-sandbox-secret"
# Email Verification (Resend)
RESEND_API_KEY=
EMAIL_FROM=
PROVIDER_PORTAL_URL=

# Telegram App & MTProto Configuration
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram MTProto Server Configuration
TELEGRAM_MTPROTO_TEST_IP="149.154.167.40"
TELEGRAM_MTPROTO_TEST_PORT=443
TELEGRAM_MTPROTO_TEST_DC=2
TELEGRAM_MTPROTO_TEST_PUBLIC_KEY=""

TELEGRAM_MTPROTO_PROD_IP="149.154.167.50"
TELEGRAM_MTPROTO_PROD_PORT=443
TELEGRAM_MTPROTO_PROD_DC=2
TELEGRAM_MTPROTO_PROD_PUBLIC_KEY=""

